# ---- Central Web (Vercel) ----
# TiDB Cloud connection string (mysql://user:pass@host:4000/db?ssl={"rejectUnauthorized":true})
DATABASE_URL=
# 32+ random bytes, base64. openssl rand -base64 48
AUTH_SECRET=
# Secret used to sign one-time agent enrollment tokens
AGENT_ENROLLMENT_SECRET=
# Public base URL of the central API (used by installers/docs)
API_BASE_URL=https://localhost:3000
# Optional: seconds allowed between agent request timestamp and server time
AGENT_SIGNATURE_MAX_SKEW_SECONDS=300
# Encrypts agent secrets at rest and signs agent tokens. openssl rand -base64 48
AGENT_SIGNING_SECRET=
