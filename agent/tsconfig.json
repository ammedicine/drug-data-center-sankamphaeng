{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": { "@shared/*": ["../src/lib/shared/*"] },
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../src/lib/shared/**/*.ts"]
}
