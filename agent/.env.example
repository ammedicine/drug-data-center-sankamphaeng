# JHCISDB connection (LOCAL ONLY - never sent to the central server)
JHCIS_DB_HOST=localhost
JHCIS_DB_PORT=3333
JHCIS_DB_DATABASE=jhcisdb
JHCIS_DB_USER=
JHCIS_DB_PASSWORD=

# Central API
CENTRAL_API_URL=https://your-app.vercel.app

# Where the agent keeps its queue, state and logs
# ที่เก็บคิว/สถานะ/credential
# ปล่อยว่างไว้ = %ProgramData%\SDCAgent บน Windows ซึ่งเจ้าหน้าที่เขียนได้
# **ห้ามตั้งเป็น ./data ในเครื่องที่ติดตั้งจริง** เพราะจะกลายเป็นโฟลเดอร์ใต้
# Program Files ที่ผู้ใช้ทั่วไปเขียนไม่ได้ agent จะบันทึกอะไรไม่ได้เลย
# (ตัวติดตั้ง copy ไฟล์นี้ไปเป็น .env จึงต้องเว้นว่างไว้)
AGENT_DATA_DIR=
AGENT_LOG_LEVEL=info
